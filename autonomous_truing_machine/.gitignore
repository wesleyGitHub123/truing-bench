.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Replay diagnostics written by test_acoustic_replay; promote with tools/capture_accept.py
test/fixtures/acoustic/captures/*.observed.json

# Raw campaign harvest from tools/campaign_recorder.py -- dozens of ~230 KB bundles.
# Promote the few that become regression fixtures; the rest stay local.
test/fixtures/acoustic/captures/_campaign/

# WAV exports from tools/capture_wav.py -- derived from the bundles, never the source of truth
test/fixtures/acoustic/captures/_wav/

# Exploratory captures: no plan, no trial numbers, no fixed n, no exclusion ledger. Deliberately
# outside _campaign/ so no analysis tool can mistake them for evidence. Nothing here supports a
# claim; anything that looks promising gets confirmed by a fresh registered run before it counts.
test/fixtures/acoustic/captures/_explore/

# Python tooling (tools/) byte-compiles here
__pycache__/
*.pyc
